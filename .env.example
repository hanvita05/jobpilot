# ---- Database ----
# Local dev (zero-config): SQLite file. This is the default the app ships with.
DATABASE_URL="file:./dev.db"
# Production (Supabase/Postgres): change datasource provider to "postgresql" in
# prisma/schema.prisma, then set a connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."

# ---- AI (optional) ----
# With no key, the app uses the built-in Demo provider (deterministic, truthful,
# fully offline). Set a key to enable free-form AI cover letters / assistant.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-sonnet-4-6"

# ---- Auth (optional; demo mode is single-user) ----
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="run: openssl rand -base64 32"
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."

# ---- Notifications (optional) ----
# Email digest (Gmail API): create OAuth creds and a refresh token.
# GMAIL_CLIENT_ID="..."
# GMAIL_CLIENT_SECRET="..."
# GMAIL_REFRESH_TOKEN="..."
# GMAIL_SENDER="you@gmail.com"
# SMS alerts (Twilio):
# TWILIO_ACCOUNT_SID="..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+1..."
# ALERT_PHONE="+1..."

# ---- Cron auth (optional) ----
# CRON_SECRET="run: openssl rand -hex 16"

# ---- Ingestion (optional) ----
# GITHUB_TOKEN raises the GitHub API rate limit for curated-list ingestion.
# GITHUB_TOKEN="ghp_..."
